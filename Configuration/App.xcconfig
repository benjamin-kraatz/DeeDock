// Shared by direct and TestFlight app targets. This file is the Release identity.
// Debug and Preview use Debug.xcconfig, which includes this file and overrides identity.
CURRENT_PROJECT_VERSION = 17
MARKETING_VERSION = 0.2.0
PRODUCT_BUNDLE_IDENTIFIER = de.benjaminkraatz.DeeDock
PRODUCT_NAME = DDock
PRODUCT_MODULE_NAME = DeeDock
INFOPLIST_KEY_CFBundleDisplayName = DDock
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Keep the saved previous icon as source material, outside app resources.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) AppIcon-old.icon
