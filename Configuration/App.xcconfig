// Shared app identity and version. These two keys are the
// only version source. Target build settings must inherit them.
CURRENT_PROJECT_VERSION = 53
MARKETING_VERSION = 0.17.0
PRODUCT_BUNDLE_IDENTIFIER = de.benjaminkraatz.DeeDock
INFOPLIST_KEY_CFBundleName = DOKK
INFOPLIST_KEY_CFBundleDisplayName = DOKK

// Injected by the build environment. AnalyticsCredentials reads these generated Info.plist keys.
INFOPLIST_KEY_DOKKAnalyticsAPIKey = $(POSTHOG_PROJECT_TOKEN)
INFOPLIST_KEY_DOKKAnalyticsHost = $(POSTHOG_HOST)

// Development builds get their own identity so macOS privacy grants
// (Accessibility, Screen Recording, Automation) for the Apple Development
// signed build never replace the Developer ID signed release's grants.
// This also separates preferences, Application Support, and keychain items.
PRODUCT_BUNDLE_IDENTIFIER[config=Debug] = de.benjaminkraatz.DeeDock.dev
PRODUCT_BUNDLE_IDENTIFIER[config=Preview] = de.benjaminkraatz.DeeDock.dev
INFOPLIST_KEY_CFBundleDisplayName[config=Debug] = DOKK Dev
INFOPLIST_KEY_CFBundleDisplayName[config=Preview] = DOKK Dev
PRODUCT_NAME = DOKK
PRODUCT_MODULE_NAME = DeeDock
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Keep the saved previous icon as source material, outside app resources.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) AppIcon-old.icon

// Per-developer values that stay out of git, such as the PostHog token. The file is optional:
// without it POSTHOG_PROJECT_TOKEN is empty and analytics are a no-op. Copy
// Local.xcconfig.example to Local.xcconfig to create it.
#include? "Local.xcconfig"
