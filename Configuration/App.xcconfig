// Shared by direct and TestFlight app targets. These two keys are the
// only version source. Target build settings must inherit them.
CURRENT_PROJECT_VERSION = 22
MARKETING_VERSION = 0.5.0
PRODUCT_BUNDLE_IDENTIFIER = de.benjaminkraatz.DeeDock
PRODUCT_NAME = DDock
PRODUCT_MODULE_NAME = DeeDock
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// Keep the saved previous icon as source material, outside app resources.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) AppIcon-old.icon
