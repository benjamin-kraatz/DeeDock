      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      }
    },
    "appStatusUnavailable": {
      "comment": "Accessibility value indicating that a pinned application cannot be found.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        }
      }
    },
    "appearanceAccessibilityHelp": {
      "comment": "Accessibility overrides and timing explanation for an inert preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion restores visibility instantly and limits idle fades to 0.1 seconds. Reduce Transparency suppresses idle fading and keeps an enabled background opaque. Saved preferences are preserved. Play Preview includes the configured idle delay."
          }
        }
      }
    },
    "appearanceBackground": {
      "comment": "Settings card title for the dock material.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background"
          }
        }
      }
    },
    "appearanceBackgroundHelp": {
      "comment": "Help for background appearance controls.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide the background for floating icons. When shown, Liquid Glass keeps its native appearance. Idle fading can temporarily dim it. Icon positions stay the same."
          }
        }
      }
    },
    "appearanceBackgroundOpacity": {
      "comment": "Opacity of the background as a percentage of its normal appearance.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background opacity"
          }
        }
      }
    },
    "appearanceFadeBackground": {
      "comment": "Fade target: dock material and separator.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background only"
          }
        }
      }
    },
    "appearanceFadeEntireDock": {
