      "comment": "Shown while dropped application bundles are being validated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking applications…"
          }
        }
      }
    },
    "dragCheckingFiles": {
      "comment": "Drag feedback while the complete external file batch is validated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking items…"
          }
        }
      }
    },
    "dragDocumentTarget": {
      "comment": "Guidance for a document or folder drag that is not yet over an available application icon.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop onto an app to open"
          }
        }
      }
    },
    "dragOpenIn": {
      "comment": "Valid document drop target. appName is the application name provided by macOS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in %(appName)@"
          }
        }
      }
    },
    "dragPinHere": {
      "comment": "Insertion feedback while dragging apps into a dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin here"
          }
        }
      }
    },
    "dragPinnedSection": {
      "comment": "Drop guidance when the pointer is over automatically ordered running apps.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag into the pinned section"
          }
        }
      }
    },
    "dragRejected": {
      "comment": "Drag feedback for an invalid batch or a destination whose pins cannot be edited.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop applications only. Pins could not be changed."
          }
        }
      }
    },
    "errorAppNotFound": {
      "comment": "Missing-application error. appName is the name of the pinned application. Unpinning does not delete the application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(appName)@ couldn’t be found. You can unpin it, then pin it again after opening the app."
          }
        }
      }
    },
    "errorHideApp": {
      "comment": "Error banner shown when the foreground application rejects DeeDock's request to hide it. appName is the application name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t hide %1$(appName)@"
          }
        }
      }
    },
    "errorInvalidDocuments": {
      "comment": "File picker validation failure; no subset of the selection is opened.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose accessible files or folders. Applications cannot be included."
          }
        }
      }
    },
    "errorLoadPins": {
      "comment": "Error banner when reading saved pins fails. details is the localized underlying error description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load pinned apps: %1$(details)@"
          }
        }
      }
    },
    "errorOpenApp": {
      "comment": "Error banner for a failed launch. appName is the application name; details is the localized underlying error description. Placeholders may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open %1$(appName)@: %2$(details)@"
          }
        }
      }
    },
    "errorOpenDocuments": {
      "comment": "Document handoff failure. appName is the receiving application; details is the system error.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open items in %1$(appName)@: %2$(details)@"
          }
        }
      }
    },
    "errorSavePins": {
      "comment": "Error banner when saving pins fails. details is the localized underlying error description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save pinned apps: %1$(details)@"
          }
        }
      }
    },
    "loginCancelRequest": {
      "comment": "Button withdrawing a login-item registration that is awaiting approval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel Request"
          }
        }
      }
    },
    "loginCancellationError": {
      "comment": "Failed withdrawal of pending approval. reason is a localized error description provided by macOS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t cancel the login request. %1$(reason)@"
          }
        }
      }
    },
    "loginCancelling": {
      "comment": "Progress text while withdrawing a login registration awaiting approval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelling the request…"
          }
        }
      }
    },
    "loginLaunchAtLogin": {
      "comment": "Toggle for starting DeeDock automatically when the current user signs in. On only when macOS approval is granted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launch at Login"
          }
        }
      }
    },
    "loginOpenSystemSettings": {
      "comment": "Button opening the macOS Login Items settings page. Never opens automatically.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open System Settings…"
          }
        }
      }
    },
    "loginPreviewLongError": {
      "comment": "Preview-only sample error to inspect wrapping with long localized text. This is not an actual diagnosis.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t enable Launch at Login. macOS couldn’t complete the request because the installed application could not be verified. Check Login Items in System Settings and try again after resolving the problem."
          }
        }
      }
    },
    "loginRefresh": {
      "comment": "Button rereading macOS login-item status without changing registration.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        }
      }
    },
    "loginRegistering": {
      "comment": "Progress text while registering the main app as a login item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requesting automatic launch…"
          }
        }
      }
    },
    "loginRegistrationError": {
      "comment": "Registration failure. reason is a localized error description provided by macOS; status is checked again after failure.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t enable Launch at Login. %1$(reason)@"
          }
        }
      }
    },
    "loginStatusEnabled": {
      "comment": "Status when macOS reports that registration and approval are enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeeDock launches automatically when you sign in, restoring your docks and menu-bar item."
          }
        }
      }
    },
    "loginStatusNotFound": {
      "comment": "Unavailable status when Service Management cannot find the main app service.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS couldn’t find DeeDock’s login item. Launch at Login is unavailable. Refresh the status or check Login Items in System Settings."
          }
        }
      }
    },
    "loginStatusOff": {
      "comment": "Status when the main app is not registered as a login item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeeDock won’t launch automatically when you sign in."
          }
        }
      }
    },
    "loginStatusRequiresApproval": {
      "comment": "Status when macOS requires approval, including when the user has revoked consent externally. The toggle stays off.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic launch is inactive. Allow DeeDock in Login Items in System Settings, or cancel the request."
          }
        }
      }
    },
    "loginStatusUnknown": {
      "comment": "Fallback for future or unknown Service Management status values. Do not imply automatic launch is enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reported an unrecognized login-item status. Launch at Login is unavailable. Refresh the status or check Login Items in System Settings."
          }
        }
      }
    },
    "loginToggleHint": {
      "comment": "Accessibility hint for the Launch at Login toggle. Turning off unregisters future startup without quitting the current app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start DeeDock automatically when you sign in. Turning this off keeps DeeDock running now."
          }
        }
      }
