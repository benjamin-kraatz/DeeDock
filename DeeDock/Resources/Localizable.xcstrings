    "secondaryDockHelp" : {
      "comment" : "Explains primary-dock behavior, permission fallback, and visible-window limitations without promising minimized-window placement.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtert auf weiteren Monitoren die Liste der nicht angepinnten, laufenden Apps. Finder erscheint dort auch angepinnt nur mit einem sichtbaren Finder-Fenster; der Schreibtisch zählt nicht. Andere Pins, Ordner, weitere Kacheln und die App-Sichtbarkeit unter Verhalten bleiben unverändert. Dafür ist die Bildschirmaufnahme-Berechtigung unten erforderlich. Fehlt sie oder ist das Hauptdock deaktiviert, entfällt der Filter. Minimierte, ausgeblendete und auf anderen Spaces liegende Fenster werden nicht zuverlässig zugeordnet. Änderungen können einige Sekunden dauern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filters unpinned running apps on secondary displays. Finder appears there only with a visible Finder window, even when pinned; the desktop does not count. Other pins, folders, utility tiles, and Behavior → App Visibility keep their normal behavior. This requires the Screen Recording permission below. Without access, or with the primary dock disabled, the filter is inactive. Minimized, hidden, and other-Space windows cannot be assigned reliably. Changes can take a few seconds."
          }
        }
      }
    },
    "secondaryDockTitle" : {
      "comment" : "Heading for the app-wide multi-monitor dock policy.",
      "extractionState" : "manual",
      "localizations" : {
