    },
    "appearanceIdleFading": {
      "comment": "Settings card title for optional idle dimming.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle fading"
          }
        }
      }
    },
    "appearanceIdleHelp": {
      "comment": "Help explaining idle detection, opacity composition, and invisible dock interaction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each display fades independently after you stop interacting with its dock. Idle opacity is a percentage of normal appearance. Hover, keyboard focus, VoiceOver, dragging, menus, and errors restore visibility. Auto-hide takes precedence. At 0% opacity, the dock remains interactive and pointer entry restores it."
          }
        }
      }
    },
    "appearanceIdleOpacity": {
      "comment": "Percentage of normal appearance retained while idle.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Idle opacity"
          }
        }
      }
    },
    "appearanceNormal": {
      "comment": "Caption for the normal dock appearance sample.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal"
          }
        }
      }
    },
    "appearancePlayback": {
      "comment": "Caption for the animated sample of idle timing.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview playback"
          }
        }
      }
    },
    "appearanceRestoreDuration": {
      "comment": "Duration of the transition back to the normal appearance, in seconds.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore duration"
          }
        }
      }
