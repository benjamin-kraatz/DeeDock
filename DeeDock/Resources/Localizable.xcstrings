    "settingsAppearanceHelp" : {
      "comment" : "Explains effective versus requested size and accessibility behavior.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Platzmangel verkleinert das Dock zuerst die Symbole, bevor es gescrollt werden kann. „Bewegung reduzieren“ deaktiviert die Vergrößerung, ohne deine Einstellung zu ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crowded docks use smaller icons before scrolling. Reduce Motion disables magnification without changing your preference."
          }
        }
      }
    },
    "settingsAppearanceKeywords" : {
      "comment" : "Space-separated search synonyms for the Appearance pane; translate to words a user would type, not literally.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Symbol Größe Vergrößerung Zoom Skalierung Mauszeiger laufend Indikator Punkt Balken Quadrat ausgeblendet Neon Aura Leuchten Target Orbit Stardust Power Badge Glitch Plasma Hologram Solar Flare Prism Shader Metal Hintergrund Deckkraft Transparenz schwebend Abdunkeln Verzögerung Wiederherstellen Tooltip App-Namen Beschriftungen Vorlagen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "icon size magnification zoom scale hover running indicator dot bar square hidden neon aura glow target orbit stardust power badge glitch plasma hologram solar flare prism shader metal background opacity transparency floating icons idle fading dimming delay restore tooltip app names labels presets caption"
          }
        }
      }
