    "fusionLimitations" : {
      "comment" : "App Fusion: Based only on reviewed text from captured visible windows and any notes you supply. Hidden content, other pages, images, and layout are not compared. This is not a complete document comparison. AI output may contain errors; review before use.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grundlage sind nur der geprüfte Text aus erfassten sichtbaren Fenstern und deine ergänzten Notizen. Verdeckte Inhalte, weitere Seiten, Bilder und Layout werden nicht verglichen. Dies ist kein vollständiger Dokumentvergleich. KI-Ergebnisse können Fehler enthalten; prüfe sie vor der Verwendung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Based only on reviewed text from captured visible windows and any notes you supply. Hidden content, other pages, images, and layout are not compared. This is not a complete document comparison. AI output may contain errors; review before use."
          }
        }
      }
    },
    "fusionLimitationsTitle" : {
      "comment" : "App Fusion: heading of the disclosure holding the limitations text",
