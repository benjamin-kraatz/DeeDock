      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeeDock"
          }
        }
      }
    },
    "appOpenHint": {
      "comment": "Accessibility hint for an application icon button. The foreground app is hidden; any other app is opened or activated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open, switch to, or hide this app"
          }
        }
      }
    },
    "appStatusNotRunning": {
      "comment": "Accessibility value indicating that the pinned application is not running.",
