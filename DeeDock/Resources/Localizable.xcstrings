    "settingsShelfHelp" : {
      "comment" : "Explains the Shelf settings card.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ablage hält Dateien bereit, die du zwischen Orten verschiebst. Lege Dateien auf dem Symbol ab und ziehe sie anschließend dorthin, wo du sie brauchst. Alle Bildschirme teilen sich den Inhalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Shelf is a staging area for files you are moving between places. Drop files on the tile to keep them there, then drag them out where you need them. Its contents are shared by every display."
          }
        }
      }
    },
