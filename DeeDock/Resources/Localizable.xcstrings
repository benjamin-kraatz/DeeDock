    "behaviorZoneHelp": {
      "comment": "Explains length along the selected edge, inward depth, offset direction, and the safe approach region.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The activation zone follows the selected dock edge. Length runs along the edge; depth extends inward. Positive offsets move right on top and bottom docks and down on side docks. The connecting region keeps the dock visible while you approach it."
          }
        }
      }
    },
    "behaviorZoneOffset": {
      "comment": "Signed activation-zone offset along the selected dock edge. Positive moves right below and down beside the display.",
