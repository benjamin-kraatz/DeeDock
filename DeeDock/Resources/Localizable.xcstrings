      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebe die Auswertungszeit unter Beibehaltung des erzeugten Verlaufs. Werte beide Engines erneut aus, um Alterung und Aufbewahrung zu prüfen. Spätere Wiedergabeschritte setzen die Uhr nicht zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Advance the evaluation clock while keeping the generated history. Replay both engines to inspect decay and retention. Later playback steps never move the clock backward."
