    "launcher.suggestions.pausedHelp" : {
      "comment" : "Explains retention when suggestions are paused or disabled.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren oder Ausschalten stoppt Lernen und Vorschläge sofort. Gespeicherte Lerndaten bleiben bis zum Ablauf oder Zurücksetzen erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausing or turning off stops learning and suggestions immediately. Saved learning data stays until it expires or you reset it."
          }
        }
      }
    },
    "launcher.suggestions.privacy" : {
      "comment" : "Privacy disclosure for opt-in app suggestions. Behavioral metadata is local and retained at most 90 days.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDock speichert bis zu 90 Tage lang nur Metadaten zur App-Nutzung auf diesem Mac, darunter App-Kennungen, Zeiten, laufende Apps, Dock-Modus und Feedback zu Vorschlägen. Fenstertitel, Dokumente, URLs, Screenshots, Tastatureingaben und Inhalte werden nicht gespeichert. Lerndaten bleiben privat auf deinem Mac."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DDock stores only app-use metadata on this Mac for up to 90 days, including app identities, times, running apps, Dock Mode, and suggestion feedback. It does not store window titles, documents, URLs, screenshots, keystrokes, or content, and sends no learning data to the cloud. Learning starts when you enable it; existing Launcher history is not imported."
          }
        }
      }
    },
    "launcher.suggestions.prompt" : {
