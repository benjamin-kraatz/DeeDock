    },
    "appearanceFadeIcons": {
      "comment": "Fade target: application icons and running indicators.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons and indicators only"
          }
