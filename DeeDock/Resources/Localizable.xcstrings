    },
    "settingsAppearanceHelp": {
      "comment": "Explains effective versus requested size and accessibility behavior.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crowded docks use smaller icons before scrolling. Reduce Motion disables magnification without changing your preference."
          }
        }
      }
    },
