    "settingsAppVisibilityHelp" : {
      "comment" : "Explains mutually exclusive app section visibility modes.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angeheftete Apps bleiben auch beim Ausführen im angehefteten Bereich. Beim Einklappen wird ein Bereich durch eine Taste ersetzt. Er bleibt nach dem Ausklappen geöffnet, bis du erneut klickst oder das Dock neu erstellt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinned apps stay in the pinned section while running. Collapse replaces one section with a button. Expansion lasts until clicked again or the dock is recreated."
          }
        }
