      "comment": "Explains mutually exclusive app section visibility modes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinned apps stay in the pinned section while running. Collapse replaces one section with a button. Expansion lasts until clicked again or the dock is recreated."
          }
        }
      }
    },
    "settingsAppearance": {
      "comment": "Settings section heading.",
      "extractionState": "manual",
      "localizations": {
