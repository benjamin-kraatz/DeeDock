    "launcher.suggestions.syntheticPlaybackHelp" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: Each step predicts before observing its next app. Run remaining repeats those steps in order. Changing tuning restarts chronological playback so metrics never mix thresholds. Ordinary Replay keeps the frozen input.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Schritt sagt die nächste App voraus, bevor er sie beobachtet. Rest ausführen wiederholt diese Schritte der Reihe nach. Änderungen an den Schwellenwerten starten die chronologische Wiedergabe neu, damit Kennzahlen keine Schwellenwerte vermischen. Die normale erneute Auswertung behält die eingefrorenen Eingaben bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each step predicts before observing its next app. Run remaining repeats those steps in order. Changing tuning restarts chronological playback so metrics never mix thresholds. Ordinary Replay keeps the frozen input."
          }
        }
      }
    },
