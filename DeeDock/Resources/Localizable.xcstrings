      "comment": "Empty dock guidance. Opening an app makes it appear temporarily; pinning keeps it in the dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an app to see it in DeeDock. Pin it to keep it here."
          }
        }
      }
    },
