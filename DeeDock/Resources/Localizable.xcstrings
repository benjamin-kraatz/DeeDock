    "windowSearchRetention" : {
      "comment" : "Window search: Searches selected titles and up to 6,000 recognized characters per window. Images and text stay in memory for 10 minutes or until you close search or clear context. Nothing is saved.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durchsucht ausgewählte Titel und bis zu 6.000 erkannte Zeichen pro Fenster. Bilder und Text bleiben höchstens 10 Minuten im Arbeitsspeicher. Schließen der Suche oder Löschen des Kontexts entfernt sie früher. Es wird nichts gespeichert."
          }
