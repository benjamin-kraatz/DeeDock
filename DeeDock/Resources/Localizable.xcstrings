    "appearanceIdleHelp" : {
      "comment" : "Help explaining idle detection, opacity composition, and invisible dock interaction.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Bildschirm blendet das Dock individuell aus, wenn es für einen festgelegten Zeitraum unbenutzt ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each display fades independently after you stop interacting with its dock. Idle opacity is a percentage of normal appearance. Hover, keyboard focus, VoiceOver, dragging, menus, and errors restore visibility. Auto-hide takes precedence. At 0% opacity, the dock remains interactive and pointer entry restores it."
          }
        }
      }
