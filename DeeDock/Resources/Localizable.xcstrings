    "launcher.suggestions.syntheticIsolation" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: Synthetic mode uses isolated generated data and works without usage consent. It never adds history or suggestions to the real Launcher. Chronological playback reveals each outcome only after prediction, then learns it for the next step.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der synthetische Modus verwendet isolierte erzeugte Daten und funktioniert ohne Einwilligung zur Nutzungserfassung. Er fügt dem echten Launcher weder Verlauf noch Vorschläge hinzu. Die chronologische Wiedergabe zeigt jedes Ergebnis erst nach der Vorhersage und lernt es dann für den nächsten Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synthetic mode uses isolated generated data and works without usage consent. It never adds history or suggestions to the real Launcher. Chronological playback reveals each outcome only after prediction, then learns it for the next step."
          }
        }
      }
    },
    "launcher.suggestions.syntheticMetrics" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: Playback metrics",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wiedergabekennzahlen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Playback metrics"
          }
        }
      }
    },
    "launcher.suggestions.syntheticMetricsHelp" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: Coverage is the share of successful prediction attempts that offer at least one eligible suggestion. A hit means the actual next app is among the first three eligible suggestions. Hit rate divides hits by offered steps. Engine failures are separate from abstention. Adaptation counts steps to the first new-pattern hit after a routine change, not sustained accuracy.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abdeckung ist der Anteil erfolgreicher Vorhersageversuche mit mindestens einem zugelassenen Vorschlag. Ein Treffer bedeutet, dass die tatsächliche nächste App unter den ersten drei zugelassenen Vorschlägen ist. Die Trefferquote teilt Treffer durch Schritte mit Vorschlägen. Engine-Fehler zählen getrennt vom Verzicht auf Vorschläge. Anpassung zählt Schritte bis zum ersten Treffer des neuen Musters nach einem Routinewechsel, nicht bis zu dauerhaft hoher Genauigkeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coverage is the share of successful prediction attempts that offer at least one eligible suggestion. A hit means the actual next app is among the first three eligible suggestions. Hit rate divides hits by offered steps. Engine failures are separate from abstention. Adaptation counts steps to the first new-pattern hit after a routine change, not sustained accuracy."
          }
        }
      }
    },
    "launcher.suggestions.syntheticNoAdaptation" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: Not observed",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
