    "focusSettingsHelp" : {
      "comment" : "Explains timer entry points, shared ownership, and clock behavior.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte eine Sitzung unter „Modi“ in den Einstellungen oder über die Menüleiste. Alle Bildschirme teilen sich einen Timer. Die Zeit läuft im Ruhezustand und bei geschlossener App weiter, während einer Pause nicht. Änderungen an diesen Vorgaben gelten für die nächste Sitzung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start from Dock Modes in Settings or the menu bar. One timer is shared by every display. Running time includes sleep and app downtime; paused time does not. Changing these defaults affects your next session."
          }
        }
