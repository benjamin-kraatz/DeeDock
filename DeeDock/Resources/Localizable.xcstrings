    "settingsAppNamesHelp" : {
      "comment" : "Help for bundled tooltip presets.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Vorlage legt Design, Position, Wartezeit und Einblendung fest. „Nach innen“ zeigt zum Schreibtisch; „vor“ und „nach“ folgen der App-Reihenfolge. Bei Tastaturbedienung erscheinen Namen sofort. „Off“ erhält die App-Namen für Bedienungshilfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each preset includes its design, placement, hover delay, and entrance. Inward is toward the desktop; before and after follow app order. Keyboard labels appear immediately. Off preserves accessible app names."
          }
        }
      }
    },
    "settingsAppVisibility" : {
      "comment" : "Behavior setting controlling which app section is hidden or collapsed.",
