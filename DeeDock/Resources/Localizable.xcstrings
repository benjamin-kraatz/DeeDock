    "launcher.suggestions.syntheticDraftHelp" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: These are draft settings. Generate scenario replaces the synthetic data with a repeatable sequence for this seed. Editing the draft cancels a running operation but keeps the generated data until you generate again.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies sind Entwurfseinstellungen. Szenario erzeugen ersetzt die synthetischen Daten durch eine mit diesem Startwert wiederholbare Abfolge. Änderungen am Entwurf brechen einen laufenden Vorgang ab. Die erzeugten Daten bleiben bis zur nächsten Erzeugung erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These are draft settings. Generate scenario replaces the synthetic data with a repeatable sequence for this seed. Editing the draft cancels a running operation but keeps the generated data until you generate again."
