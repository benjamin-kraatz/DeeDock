      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur der Text unten wird an das lokale Modell übergeben. Korrigiere Erkennungsfehler oder ergänze Notizen, bis zu 6.000 Zeichen je Quelle. Die Eingaben bleiben höchstens 15 Minuten im Arbeitsspeicher. Vergleich und Unterschiede benötigen Text aus beiden Quellen; für eine Checkliste genügt eine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
