        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What this result is based on"
          }
        }
      }
    },
    "fusionModelUnavailable" : {
      "comment" : "App Fusion: Apple Intelligence is unavailable. Check that it is enabled and the on-device model has finished downloading, then retry. Your reviewed input stays available until it expires.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
