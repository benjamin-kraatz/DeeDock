            "state" : "translated",
            "value" : "Settings…"
          }
        }
      }
    },
    "actionsHelp" : {
      "comment" : "Explains shared shortcut tiles, input, output, and cancellation.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pinne Kurzbefehle auf allen Displays an. Klicke auf eine Kachel, um den Kurzbefehl auszuführen, oder ziehe Dateien darauf, um sie als Eingabe zu übergeben. Lege im Kurzbefehl fest, wie das Ergebnis gespeichert oder angezeigt wird. Abbrechen beendet das Warten, macht bereits ausgeführte Aktionen aber nicht rückgängig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pin shortcuts on every display. Click a tile to run it, or drop files onto it as input. Configure the shortcut to save or show its output. Cancel stops waiting; it cannot undo actions already performed."
          }
        }
      }
    },
    "actionsLoad" : {
      "comment" : "Read installed shortcut names and identifiers without executing them.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle laden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Load Shortcuts"
          }
        }
      }
    },
