    "settingsPositionHelp" : {
      "comment" : "Explains physical offset direction, edge distance, and clamping for all dock edges.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive Versätze verschieben das Dock oben und unten nach rechts, an den Seiten nach unten. Der Randabstand wird bis zur Außenkante des Glases gemessen. Die Position bleibt auf den Bildschirm begrenzt; die gewünschten Werte bleiben gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Positive offsets move right on top and bottom docks and down on side docks. Edge distance measures to the outside of the glass. Placement is constrained to the display; requested values remain saved."
          }
        }
      }
    },
    "settingsPositionKeywords" : {
