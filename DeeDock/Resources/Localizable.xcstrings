      }
    },
    "appearanceAccessibilityHelp" : {
      "comment" : "Accessibility overrides and timing explanation for an inert preview.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bewegungen reduzieren“ stellt die Sichtbarkeit des Docks sofort wieder her und limitiert das Ausblenden auf 0,1 Sekunde. „Transparenz reduzieren“ behält den Hintergrund immer undurchsichtig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce Motion restores visibility instantly and limits idle fades to 0.1 seconds. Reduce Transparency suppresses idle fading and keeps an enabled background opaque. Saved preferences are preserved. Play Preview includes the configured idle delay."
          }
        }
      }
    },
    "appearanceBackground" : {
      "comment" : "Settings card title for the dock material.",
      "extractionState" : "manual",
