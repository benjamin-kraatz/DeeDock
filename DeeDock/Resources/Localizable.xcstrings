    "launcher.suggestions.syntheticClockHelp" : {
      "comment" : "Development-only isolated synthetic suggestion inspector: Advance the evaluation clock while keeping the generated history. Replay both engines to inspect decay and retention. Later playback steps never move the clock backward.",
