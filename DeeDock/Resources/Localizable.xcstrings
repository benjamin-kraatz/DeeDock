    "appearanceAccessibilityHelp": {
      "comment": "Accessibility overrides and timing explanation for an inert preview.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce Motion restores visibility instantly and limits idle fades to 0.1 seconds. Reduce Transparency suppresses idle fading and keeps an enabled background opaque. Saved preferences are preserved. Play Preview includes the configured idle delay."
          }
        }
      }
    },
