      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fade when idle"
          }
        }
      }
    },
    "appearanceIdle": {
      "comment": "Caption for the idle dock appearance sample.",
