{
  "sourceLanguage": "en",
  "strings": {
    "actionDismissError": {
      "comment": "Accessibility label for the close button on an error message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss error"
          }
        }
      }
    },
    "actionFocusDock": {
      "comment": "Menu command that enables keyboard navigation through dock icons.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Dock"
          }
        }
      }
    },
    "actionMoveDown": {
      "comment": "Move a pin one place toward the bottom of a side dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Down"
          }
        }
      }
    },
    "actionMoveLeft": {
      "comment": "Move a pinned application one position to the left.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Left"
          }
        }
      }
    },
    "actionMoveRight": {
      "comment": "Move a pinned application one position to the right.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Right"
          }
        }
      }
    },
    "actionMoveUp": {
      "comment": "Move a pin one place toward the top of a side dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Up"
          }
        }
      }
    },
    "actionOpen": {
      "comment": "Context-menu action that opens or activates the selected application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "actionOpenFiles": {
      "comment": "Context-menu and accessibility action. Choose files or folders to open in this application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Files…"
          }
        }
      }
    },
    "actionPin": {
      "comment": "Context-menu and accessibility action. Keep this app in the pinned section even when it is not running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin"
          }
        }
      }
    },
    "actionPinOnDisplay": {
      "comment": "Submenu listing other connected displays that have a dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin on Display…"
          }
        }
      }
    },
    "actionPinOnDisplayName": {
      "comment": "VoiceOver action to pin an app on the named display. Display name comes from macOS.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin on %(display)@"
          }
        }
      }
    },
    "actionQuit": {
      "comment": "Menu command that exits DeeDock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit DeeDock"
          }
        }
      }
    },
    "actionSettings": {
      "comment": "Menu command opening the native settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "actionUnpin": {
      "comment": "Context-menu and accessibility action. Stop keeping this app pinned; a running app remains in the running section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin"
          }
        }
      }
    },
