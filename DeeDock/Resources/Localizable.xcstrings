    "actionsCancelled" : {
      "comment" : "Cancellation may not undo shortcut side effects.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warten beendet. Bereits ausgeführte Aktionen wurden nicht rückgängig gemacht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopped waiting. Actions already performed were not undone."
          }
        }
      }
    },
    "actionsDiscoveryFailed" : {
      "comment" : "Shortcut discovery failure, followed by system details.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzbefehle konnten nicht geladen werden: %1$@"
