            "state" : "translated",
            "value" : "%(status)@, badge: %(badge)@"
          }
        }
      }
    },
    "appBadgesHelp" : {
      "comment" : "Explains badge coverage, refresh delay, and permission scope.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übernimmt die Mitteilungskennzeichen von Apps im macOS-Dock. Apps, die dort fehlen oder eigene Grafiken verwenden, stellen möglicherweise kein Kennzeichen bereit. Änderungen können einige Sekunden dauern. Die Berechtigung zur Bildschirmaufnahme ist dafür nicht erforderlich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mirrors badge text from apps in the macOS Dock. Apps missing from that Dock or using custom artwork may not expose a badge. Updates can take a few seconds. Screen Recording is not required."
          }
        }
      }
    },
    "appBadgesPermission" : {
      "comment" : "Explains why Accessibility permission is needed for badges.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube den Zugriff über die Bedienungshilfen, um Mitteilungskennzeichen zu lesen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Accessibility access to read app badges."
          }
        }
      }
    },
    "appBadgesTitle" : {
      "comment" : "Heading for the app badge feature.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App-Mitteilungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App badges"
          }
        }
      }
    },
