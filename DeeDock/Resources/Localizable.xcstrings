{
  "sourceLanguage": "en",
  "strings": {
    "actionDismissError": {
      "comment": "Accessibility label for the close button on an error message.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss error"
          }
        }
      }
    },
    "actionFocusDock": {
      "comment": "Menu command that enables keyboard navigation through dock icons.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Focus Dock"
          }
        }
      }
    },
    "actionOpen": {
      "comment": "Context-menu action that opens or activates the selected application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open"
          }
        }
      }
    },
    "actionPin": {
      "comment": "Context-menu and accessibility action. Keep this app in the pinned section even when it is not running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin"
          }
        }
      }
    },
    "actionQuit": {
      "comment": "Menu command that exits DeeDock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit DeeDock"
          }
        }
      }
    },
    "actionSettings": {
      "comment": "Menu command opening the native settings window.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings…"
          }
        }
      }
    },
    "actionUnpin": {
      "comment": "Context-menu and accessibility action. Stop keeping this app pinned; a running app remains in the running section.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpin"
          }
        }
      }
    },
    "appName": {
      "comment": "Product name, used by the menu-bar item and dock panel. Keep the brand name unchanged.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DeeDock"
          }
        }
      }
    },
    "appOpenHint": {
      "comment": "Accessibility hint for an application icon button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open or switch to this app"
          }
        }
      }
    },
    "appStatusNotRunning": {
      "comment": "Accessibility value indicating that the pinned application is not running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not running"
          }
        }
      }
    },
    "appStatusRunning": {
      "comment": "Accessibility value indicating that the application is running.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      }
    },
    "appStatusUnavailable": {
      "comment": "Accessibility value indicating that a pinned application cannot be found.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unavailable"
          }
        }
      }
    },
    "dockEmptyState": {
      "comment": "Empty dock guidance. Opening an app makes it appear temporarily; pinning keeps it in the dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an app to see it in DeeDock. Pin it to keep it here."
          }
        }
      }
    },
    "errorAppNotFound": {
      "comment": "Missing-application error. appName is the name of the pinned application. Unpinning does not delete the application.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$(appName)@ couldn’t be found. You can unpin it, then pin it again after opening the app."
          }
        }
      }
    },
    "errorLoadPins": {
      "comment": "Error banner when reading saved pins fails. details is the localized underlying error description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load pinned apps: %1$(details)@"
          }
        }
      }
    },
    "errorOpenApp": {
      "comment": "Error banner for a failed launch. appName is the application name; details is the localized underlying error description. Placeholders may be reordered.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open %1$(appName)@: %2$(details)@"
          }
        }
      }
    },
    "errorSavePins": {
      "comment": "Error banner when saving pins fails. details is the localized underlying error description.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save pinned apps: %1$(details)@"
          }
        }
      }
    },
    "settingsAlignCenter": {
      "comment": "Horizontal center alignment.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Center"
          }
        }
      }
    },
    "settingsAlignLeft": {
      "comment": "Physical left alignment, not text reading direction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left"
          }
        }
      }
    },
    "settingsAlignRight": {
      "comment": "Physical right alignment, not text reading direction.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right"
          }
        }
      }
    },
    "settingsAlignment": {
      "comment": "Label for the horizontal dock anchor.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal alignment"
          }
        }
      }
    },
    "settingsAllowedRange": {
      "comment": "Numeric field help. lower and upper are locale-formatted numeric limits. Units appear next to the field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allowed range: %1$(lower)@ to %2$(upper)@."
          }
        }
      }
    },
    "settingsAppearance": {
      "comment": "Settings section heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        }
      }
    },
    "settingsAppearanceHelp": {
      "comment": "Explains effective versus requested size and accessibility behavior.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crowded docks use smaller icons before scrolling. Reduce Motion disables magnification without changing your preference."
          }
        }
      }
    },
    "settingsAppearanceKeywords": {
      "comment": "Space-separated search synonyms for the Appearance pane; translate to words a user would type, not literally.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "icon size magnification zoom scale hover"
          }
        }
      }
    },
    "settingsBottomDistance": {
      "comment": "Distance from the chosen bottom edge to the glass bottom, in points.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bottom distance"
          }
        }
      }
    },
    "settingsCardAnchor": {
      "comment": "Heading for the group choosing the reference frame and horizontal alignment.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anchor"
          }
        }
      }
    },
    "settingsCardFineTuning": {
      "comment": "Heading for the group with the offset and bottom distance sliders.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fine-tuning"
          }
        }
      }
    },
    "settingsCardIcons": {
      "comment": "Heading for the icon size and magnification group.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icons"
          }
        }
      }
    },
    "settingsDockOverlapHelp": {
      "comment": "Coexistence note; no system preferences are changed.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen-edge positioning can overlap the system Dock. An automatically hidden system Dock may overlap either mode."
          }
        }
      }
    },
    "settingsGroupDock": {
      "comment": "Sidebar group heading collecting the dock configuration panes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock"
          }
        }
      }
    },
    "settingsHorizontalOffset": {
      "comment": "Signed offset in points; positive is right.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Horizontal offset"
          }
        }
      }
    },
    "settingsIconSize": {
      "comment": "Requested resting app icon size in logical points.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Icon size"
          }
        }
      }
    },
    "settingsInvalidNumber": {
      "comment": "Inline feedback for incomplete, invalid, or out-of-range numeric input.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a number within the allowed range."
          }
        }
      }
    },
    "settingsLoadError": {
      "comment": "Corrupt saved settings are preserved until the user explicitly resets.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read saved settings. Defaults are being used. Choose Restore Defaults to replace the unreadable settings; your pinned apps will be kept."
          }
        }
      }
    },
    "settingsMagnification": {
      "comment": "Maximum hover scale; 1 means no magnification.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maximum magnification"
          }
        }
      }
    },
    "settingsMultiplier": {
      "comment": "Unit symbol for magnification scale.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "×"
          }
        }
      }
    },
    "settingsNoMatches": {
      "comment": "Shown in the settings sidebar when a search filters out every pane.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No settings match your search."
          }
        }
      }
    },
    "settingsPoints": {
      "comment": "Abbreviation for logical points in numeric settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "pt"
          }
        }
      }
    },
    "settingsPosition": {
      "comment": "Settings section heading.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position"
          }
        }
      }
    },
    "settingsPositionHelp": {
      "comment": "Explains direction and display clamping.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Positive offsets move right; negative offsets move left. Placement stays within the display while your requested values are remembered."
          }
        }
      }
    },
    "settingsPositionKeywords": {
      "comment": "Space-separated search synonyms for the Position pane; translate to words a user would type, not literally.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "position placement alignment offset bottom edge screen display margin"
          }
        }
      }
    },
    "settingsPositionReference": {
      "comment": "Label for the frame used to measure dock placement.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position relative to"
          }
        }
      }
    },
    "settingsPreview": {
      "comment": "Heading for the illustrated, non-interactive preview of the current settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview"
          }
        }
      }
    },
    "settingsPreviewDisclaimer": {
      "comment": "Clarifies that the preview uses sample icons and a stand-in display.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An illustration of your settings, not a live view of your dock."
          }
        }
      }
    },
    "settingsRestoreDefaults": {
      "comment": "Resets configuration only; pinned apps are preserved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore Defaults"
          }
        }
      }
    },
    "settingsSaveError": {
      "comment": "A failed edit was not published; user can retry.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save settings. Your previous settings are still in use."
          }
        }
      }
    },
    "settingsScreenEdge": {
      "comment": "Physical display frame, including areas occupied by the system Dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen edge"
          }
        }
      }
    },
    "settingsSearchPrompt": {
      "comment": "Placeholder in the settings sidebar search field.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search"
          }
        }
      }
    },
    "settingsSelectCategory": {
      "comment": "Placeholder shown when no settings pane is selected.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a settings category"
          }
        }
      }
    },
    "settingsUsableDesktop": {
      "comment": "Frame excluding space reserved by macOS, including the system Dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usable desktop"
          }
        }
      }
    },
    "displayUnnamed": {
      "comment": "Fallback display name when macOS provides no localized name.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Display"
          }
        }
      }
    },
    "displayProfilesError": {
      "comment": "Shown in Settings when display metadata is malformed or cannot be saved.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read or save display preferences. Saved profiles have not been replaced."
          }
        }
      }
    },
    "displayDefaults": {
      "comment": "Sidebar section for shared settings inherited by displays.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Defaults"
          }
        }
      }
    },
    "displayConnectedGroup": {
      "comment": "Sidebar section for online displays, including mirror followers.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected displays"
          }
        }
      }
    },
    "displayRememberedGroup": {
      "comment": "Sidebar section for retained profiles that are currently offline.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected displays"
          }
        }
      }
    },
    "displayConnected": {
      "comment": "Display connection status.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected"
          }
        }
      }
    },
    "displayPrimaryConnected": {
      "comment": "Display status indicating the main display.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected · Primary"
          }
        }
      }
    },
    "displayDisconnected": {
      "comment": "Display connection status; preferences remain editable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnected"
          }
        }
      }
    },
    "displayMirrored": {
      "comment": "Status for a display showing another display’s desktop.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mirrored"
          }
        }
      }
    },
    "displaySessionOnly": {
      "comment": "Identity could not safely be persisted.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session only"
          }
        }
      }
    },
    "displayDockDisabled": {
      "comment": "Accessibility label for a disabled display dock.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock disabled"
          }
        }
      }
    },
    "displayShowDock": {
      "comment": "Per-display visibility toggle; retained across reconnects.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show Dock"
          }
        }
      }
    },
    "displayCustomized": {
      "comment": "Indicates an explicit per-setting display override.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Customized"
          }
        }
      }
    },
    "displayFollowingDefault": {
      "comment": "Setting inherits the shared default, including future changes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following default"
          }
        }
      }
    },
    "displayUseDefault": {
      "comment": "Clear one display setting override.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Default"
          }
        }
      }
    },
    "displayUseDefaults": {
      "comment": "Clear all appearance and position overrides for this display; preserve pins and visibility.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Defaults"
          }
        }
      }
    },
    "displayIdentityWarning": {
      "comment": "Missing or duplicate display identity: session-only state is used.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This display cannot be identified reliably. Changes apply only for this connection and won’t replace any saved display profile."
          }
        }
      }
    },
    "displayMirrorHelp": {
      "comment": "Explains why a mirror follower does not create another panel.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While mirroring, the source display controls the dock. These preferences will apply when this display has its own desktop again."
          }
        }
      }
    },
    "displayDisconnectedHelp": {
      "comment": "Offline profiles remain editable.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are saved for when this display reconnects."
          }
        }
      }
    }
  },
  "version": "1.3"
}
